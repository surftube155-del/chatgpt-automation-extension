{
  "manifest_version": 3,
  "name": "ChatGPT Persistent Continuation Automation",
  "version": "1.0.0",
  "description": "Automate long sequential interactions within ONE existing ChatGPT conversation",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.openai.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ChatGPT Automation"
  },
  "background": {
    "service_worker": "background/serviceWorker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://*.openai.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
